---
interface Props {
    title: string;
    year: string | number;
    month: number;
    description: string;
    tags: string[];
    href?: string;
}

const { title, year, month, description, tags, href = "#" } = Astro.props;

const monthNames = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
];
const displayDate = `${monthNames[month - 1]} ${year}`;
---

<article class="group cursor-default">
    <div
        class="flex justify-between items-baseline border-b border-border-low pb-2 mb-2 group-hover:border-primary transition-colors duration-200"
    >
        <h2 class="text-headline-md">
            <a
                href={href}
                class="hover:text-secondary transition-colors duration-200"
            >
                {title}
            </a>
        </h2>
        <span class="text-label-caps text-text-muted shrink-0 ml-4"
            >{displayDate}</span
        >
    </div>
    <p class="text-body-md mb-3 text-on-surface-variant">{description}</p>
    <div class="flex flex-wrap gap-2">
        {
            tags.map((tag) => (
                <span class="text-code-snippet bg-surface-container px-2 py-0.5 rounded-lg">
                    {tag}
                </span>
            ))
        }
    </div>
</article>
