---
interface Props {
  title: string;
  year: string | number;
  description: string;
  tags: string[];
  href?: string;
}

const { title, year, description, tags, href = "#" } = Astro.props;
---

<article class="group cursor-default">
  <div class="flex justify-between items-baseline border-b border-border-low pb-2 mb-2 group-hover:border-primary transition-colors duration-200">
    <h2 class="text-headline-md">
      <a href={href} class="hover:text-secondary transition-colors duration-200">
        {title}
      </a>
    </h2>
    <span class="text-label-caps text-text-muted shrink-0 ml-4">{year}</span>
  </div>
  <p class="text-body-md mb-3 text-on-surface-variant">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="text-code-snippet bg-surface-container px-2 py-0.5 rounded-lg">{tag}</span>
    ))}
  </div>
</article>
