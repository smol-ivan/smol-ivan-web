---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    activeNav?: "about" | "projects" | "posts";
}

const {
    title,
    description = "Ivan's site - Software Engineer",
    activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="us">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>

        <ClientRouter />

        <!-- Inline theme init to prevent FOUC -->
        <script is:inline>
            function applyThemeInline() {
                const stored = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                if (stored === "dark" || (!stored && prefersDark)) {
                    document.documentElement.classList.add("dark");
                } else {
                    document.documentElement.classList.remove("dark");
                }
            }
            applyThemeInline();
            document.addEventListener("astro:after-swap", applyThemeInline);
        </script>

        <!-- Hide Material Symbols text until font loads -->
        <style>
            .material-symbols-outlined {
                font-size: 0 !important;
            }
            .material-symbols-outlined.font-loaded {
                font-size: revert !important;
            }
        </style>
        <script is:inline>
            (function () {
                if (document.fonts && document.fonts.check("1em Material Symbols Outlined")) {
                    document.querySelectorAll(".material-symbols-outlined").forEach(function(el) {
                        el.classList.add("font-loaded");
                    });
                } else if (document.fonts) {
                    document.fonts.ready.then(function () {
                        document.querySelectorAll(".material-symbols-outlined").forEach(function(el) {
                            el.classList.add("font-loaded");
                        });
                    });
                }
            })();
        </script>
    </head>
    <body
        class="bg-background text-on-background min-h-screen flex flex-col transition-colors duration-200 font-mono-system"
    >
        <!-- ── Header / Nav ────────────────────────────── -->
        <header
            transition:persist
            class="w-full border-b border-border-low sticky top-0 bg-background/90 backdrop-blur-sm z-50 transition-colors duration-200"
        >
            <div
                class="max-w-[720px] mx-auto flex justify-between items-center py-stack-md px-margin-page"
            >
                <!-- Left: theme toggle + home -->
                <div class="flex items-center gap-4">
                    <!--  TODO: Fix problem w icons for the toggle theme-->
                    <button
                        id="theme-toggle"
                        aria-label="Cambiar tema"
                        class="flex items-center p-1 bg-surface-container rounded-full cursor-pointer active:opacity-70 transition-all"
                    >
                        <div class="w-12 h-6 flex items-center relative px-1">
                            <div
                                id="toggle-thumb"
                                class="w-4 h-4 bg-primary rounded-full transition-transform duration-300 translate-x-0"
                            >
                            </div>
                            <span
                                id="light-icon"
                                class="material-symbols-outlined absolute right-1 text-[12px] select-none transition-opacity"
                                >light_mode</span
                            >
                            <span
                                id="dark-icon"
                                class="material-symbols-outlined absolute left-1 text-[12px] select-none opacity-0 transition-opacity"
                                >dark_mode</span
                            >
                        </div>
                    </button>

                    <a
                        href="/"
                        class="text-headline-md font-bold text-primary hover:text-secondary transition-colors duration-200"
                    >
                        Home
                    </a>
                </div>

                <!-- Right: nav links -->
                <nav
                    class="flex items-center gap-6 text-body-lg"
                    aria-label="Navegación principal"
                >
                    <a
                        href="/about"
                        class="nav-item text-text-muted hover:text-secondary transition-colors duration-200"
                        data-nav="about"
                    >
                        About
                    </a>
                    <a
                        href="/projects"
                        class="nav-item text-text-muted hover:text-secondary transition-colors duration-200"
                        data-nav="projects"
                    >
                        Projects
                    </a>
                    <a
                        href="/posts"
                        class="nav-item text-text-muted hover:text-secondary transition-colors duration-200"
                        data-nav="posts"
                    >
                        Posts
                    </a>
                </nav>
            </div>
        </header>

        <!-- ── Page Content ────────────────────────────── -->
        <slot />

        <!-- ── Footer ─────────────────────────────────── -->
        <footer
            transition:persist
            class="w-full border-t border-border-low sticky bottom-0 bg-background transition-colors duration-200"
        >
            <div
                class="max-w-[720px] mx-auto flex flex-col items-center gap-stack-sm py-stack-sm px-margin-page"
            >
                <div
                    class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-label-caps text-text-muted"
                >
                    <a
                        href="https://github.com/smol-ivan"
                        target="_blank"
                        rel="noopener"
                        class="hover:text-secondary transition-colors duration-200"
                        >GitHub</a
                    >
                    <a
                        href="https://linkedin.com/in/smol-ivan"
                        target="_blank"
                        rel="noopener"
                        class="hover:text-secondary transition-colors duration-200"
                        >LinkedIn</a
                    >
                    <!-- <a
                        href="https://x.com"
                        target="_blank"
                        rel="noopener"
                        class="hover:text-secondary transition-colors duration-200"
                        >Twitter / X</a
                    > -->
                    <a
                        href="mailto:gordillosolis@icloud.com"
                        class="hover:text-secondary transition-colors duration-200"
                        >Email</a
                    >
                </div>
                <p class="text-label-caps text-text-muted opacity-60">
                    © 2025 Ivan Gordillo · Powered by <a
                        href="https://astro.build"
                        class="underline hover:text-secondary transition-colors"
                        >Astro</a
                    >
                </p>
            </div>
        </footer>
    </body>
</html>

<script is:inline>
    // ── Theme Toggle ─────────────────────────────────────
    function initThemeToggle() {
        var btn = document.getElementById("theme-toggle");
        var thumb = document.getElementById("toggle-thumb");
        var darkIcon = document.getElementById("dark-icon");
        var lightIcon = document.getElementById("light-icon");
        var html = document.documentElement;

        if (!btn || !thumb || !darkIcon || !lightIcon) return;

        function applyTheme(dark) {
            if (dark) {
                html.classList.add("dark");
                thumb.style.transform = "translateX(1.5rem)";
                darkIcon.style.opacity = "1";
                lightIcon.style.opacity = "0";
            } else {
                html.classList.remove("dark");
                thumb.style.transform = "translateX(0)";
                darkIcon.style.opacity = "0";
                lightIcon.style.opacity = "1";
            }
        }

        // Initialize from current state
        applyTheme(html.classList.contains("dark"));

        // Remove old listener to avoid duplicates (since we use is:inline)
        var newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);

        newBtn.addEventListener("click", function () {
            var isDark = html.classList.contains("dark");
            applyTheme(!isDark);
            localStorage.setItem("theme", isDark ? "light" : "dark");
        });

        // Re-assign references after cloning
        thumb = newBtn.querySelector("#toggle-thumb") || document.getElementById("toggle-thumb");
        darkIcon = newBtn.querySelector("#dark-icon") || document.getElementById("dark-icon");
        lightIcon = newBtn.querySelector("#light-icon") || document.getElementById("light-icon");
    }

    // Run on initial load
    initThemeToggle();

    // Run again after View Transitions swap
    document.addEventListener("astro:page-load", function() {
        initThemeToggle();
        
        // Update active nav link
        var path = window.location.pathname;
        var navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(function(item) {
            item.classList.remove('nav-link-active');
            var href = item.getAttribute('href');
            if (path.startsWith(href)) {
                item.classList.add('nav-link-active');
            }
        });
    });

    // Also handle font loading for icons
    function markFontsLoaded() {
        document.querySelectorAll(".material-symbols-outlined").forEach(function(el) {
            el.classList.add("font-loaded");
        });
    }
    if (document.fonts && document.fonts.check("1em Material Symbols Outlined")) {
        markFontsLoaded();
    } else if (document.fonts) {
        document.fonts.ready.then(markFontsLoaded);
    }
</script>
