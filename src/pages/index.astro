---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
    title="Ivan Gordillo"
    description="Ivan Gordillo Portfolio - Kind of nerdy, computer engineer."
>
    <!-- ── Hero ──────────────────────────────────────── -->
    <main
        class="flex-grow flex flex-col items-center justify-center py-stack-lg px-margin-page"
    >
        <div class="max-w-[720px] w-full text-center space-y-stack-md">
            <!-- Profile Info -->
            <div class="space-y-4">
                <h1
                    class="text-headline-lg md:text-[48px] font-bold tracking-tight text-primary"
                >
                    Ivan Gordillo
                </h1>
                <p
                    class="text-body-lg text-text-muted leading-relaxed max-w-[600px] mx-auto"
                >
                    Kinda nerdy. I wish I had a cat, I'll name it 'Helix'
                </p>
            </div>

            <!-- Social Links -->
            <div class="flex justify-center pt-stack-sm">
                <div
                    class="flex items-center gap-6 px-4 py-4 border-[3px] rounded-2xl bg-surface-container-lowest"
                >
                    <a
                        href="/ivan_gordillo_cv.pdf"
                        download="ivan_gordillo_cv.pdf"
                        title="Resume"
                        class="text-primary hover:text-secondary transition-colors duration-200"
                        aria-label="Descargar CV"
                    >
                        <Icon name="akar-icons:file" class="size-6" />
                    </a>
                    <a
                        href="mailto:gordillosolis@icloud.com"
                        title="Email"
                        class="text-primary hover:text-secondary transition-colors duration-200"
                        aria-label="Enviar correo"
                    >
                        <Icon name="majesticons:mail-line" class="size-7" />
                    </a>
                    <a
                        href="https://github.com/smol-ivan"
                        target="_blank"
                        rel="noopener"
                        title="GitHub"
                        class="text-primary hover:text-secondary transition-colors duration-200"
                        aria-label="GitHub"
                    >
                        <Icon name="eva:github-outline" class="size-7" />
                    </a>
                    <a
                        href="https://linkedin.com/in/smol-ivan"
                        target="_blank"
                        rel="noopener"
                        title="LinkedIn"
                        class="text-primary hover:text-secondary transition-colors duration-200"
                        aria-label="LinkedIn"
                    >
                        <Icon name="meteor-icons:linkedin" class="size-6" />
                    </a>
                </div>
            </div>

            <!-- Decorative divider -->
            <div class="pt-stack-lg hidden md:block">
                <div
                    class="w-px h-24 bg-gradient-to-b from-border-low to-transparent mx-auto opacity-50"
                >
                </div>
            </div>
        </div>
    </main>
</Layout>
