---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => {
    if (a.data.year !== b.data.year) {
        return a.data.year - b.data.year;
    }
    return b.data.month - a.data.month;
});
---

<Layout
    title="Projects — Ivan Gordillo"
    description="Colección de experimentos técnicos, proyectos de documentación y contribuciones de Ivan Gordillo."
    activeNav="projects"
>
    <main
        class="flex-grow max-w-[720px] w-full mx-auto px-margin-page py-stack-lg"
    >
        <!-- ── Page Title ─────────────────────────────── -->
        <section class="mb-stack-lg text-center">
            <h1 class="text-headline-lg mb-stack-sm">Projects</h1>
            <p class="text-body-lg text-text-muted">
                A collection of hard work.
            </p>
        </section>

        <!-- ── Projects List ──────────────────────────── -->
        <div class="space-y-12 text-center">
            <p class="text-4xl"></p>
            {
                projects.map((project) => (
                    <ProjectCard
                        title={project.data.title}
                        year={project.data.year}
                        month={project.data.month}
                        description={project.data.description}
                        tags={project.data.tags}
                        href={project.data.href}
                    />
                ))
            }
        </div>

