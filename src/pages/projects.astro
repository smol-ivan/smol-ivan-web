<Layout
  title="Projects — Ivan Gordillo"
  description="Colección de experimentos técnicos, proyectos de documentación y contribuciones de Ivan Gordillo."
  activeNav="projects"
>
  <main class="max-w-[720px] mx-auto px-margin-page py-stack-lg min-h-[calc(100vh-200px)]">

    <!-- ── Page Title ─────────────────────────────── -->
    <section class="mb-stack-lg text-center">
      <h1 class="text-headline-lg mb-stack-sm">Projects</h1>
      <p class="text-body-lg text-text-muted">
        A collection of hard work.
      </p>
    </section>

    <!-- ── Projects List ──────────────────────────── -->
    <div class="space-y-12">
        <p class="text-4xl">Pending to update</p>
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          year={project.year}
          description={project.description}
          tags={project.tags}
          href={project.href}
        />
      ))}
    </div>

