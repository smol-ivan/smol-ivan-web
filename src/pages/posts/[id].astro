---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// Generar rutas dinámicas para cada post
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Formatear fecha
const formatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const formattedDate = formatter.format(post.data.date);
---

<Layout
  title={`${post.data.title} — PaperMod`}
  description={post.data.description}
  activeNav="posts"
>
  <main class="max-w-[720px] mx-auto px-margin-page md:px-0 py-stack-lg min-h-screen">
    
    <!-- ── Navegación atrás ────────────────────────── -->
    <div class="mb-stack-md">
      <a
        class="group flex items-center gap-2 text-body-md text-text-muted hover:text-primary transition-colors duration-200 w-fit"
        href="/posts"
      >
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        <span>Back to Posts</span>
      </a>
    </div>

    <!-- ── Cabecera del Artículo ───────────────────── -->
    <article>
      <header class="mb-stack-lg">
        <h1 class="text-headline-lg mb-stack-sm tracking-tight text-primary">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-label-caps text-text-muted border-b border-border-low pb-stack-sm">
          
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">calendar_today</span>
            {formattedDate}
          </span>
          
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">schedule</span>
            {post.data.readingTime}
          </span>

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex gap-2">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 bg-surface-container text-on-surface-variant border border-border-low rounded-sm">
                  #{tag.toUpperCase()}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- ── Imagen Destacada ──────────────────────── -->
      {post.data.image && (
        <div class="mb-stack-lg">
          <img
            class="w-full aspect-video object-cover grayscale hover:grayscale-0 transition-all duration-700 border border-border-low"
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
          />
        </div>
      )}

      <!-- ── Contenido Markdown (Renderizado) ──────── -->
      <section class="space-y-stack-md text-body-lg text-on-background leading-relaxed prose prose-invert max-w-none prose-p:text-body-lg prose-headings:text-primary prose-a:text-secondary prose-a:no-underline hover:prose-a:underline prose-code:text-code-snippet prose-code:bg-surface-container prose-code:px-1 prose-code:py-0.5 prose-code:rounded-sm prose-pre:border prose-pre:border-border-high prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-surface-container-low prose-blockquote:p-stack-md prose-blockquote:not-italic prose-blockquote:text-text-muted prose-li:my-1">
        <Content />
      </section>

      <!-- ── Social Links Bar (Post Footer) ────────── -->
      <footer class="mt-stack-lg pt-stack-md border-t border-border-low flex justify-between items-center">
        <div class="flex gap-stack-sm">
          <div class="w-10 h-10 border border-border-low flex items-center justify-center hover:text-secondary hover:border-secondary transition-all cursor-pointer rounded-lg">
            <span class="material-symbols-outlined text-text-muted">share</span>
          </div>
          <div class="w-10 h-10 border border-border-low flex items-center justify-center hover:text-secondary hover:border-secondary transition-all cursor-pointer rounded-lg">
            <span class="material-symbols-outlined text-text-muted">bookmark</span>
          </div>
        </div>
        <div class="flex gap-4">
          <a class="text-label-caps text-text-muted hover:text-primary underline underline-offset-4 transition-colors" href="/posts">
            All Posts →
          </a>
        </div>
      </footer>
    </article>
  </main>
</Layout>

<style is:global>
  /* 
    Estilos inyectados globalmente para los elementos HTML generados por Astro a partir del Markdown,
    para que se parezcan lo más posible a tu diseño original.
  */
  .prose h2 {
    font-size: var(--font-size-headline-md);
    font-weight: 600;
    margin-top: var(--spacing-stack-md);
    margin-bottom: var(--spacing-stack-sm);
    padding-top: var(--spacing-stack-sm);
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    line-height: 1.4;
  }
  .prose h3 {
    font-size: 18px;
    font-weight: 600;
    margin-top: var(--spacing-stack-md);
    margin-bottom: var(--spacing-stack-sm);
    line-height: 1.4;
  }
  .prose ul {
    list-style: none;
    padding: 0;
    margin-top: var(--spacing-stack-md);
  }
  .prose ul li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  /* Simulamos el "→" antes de las listas */
  .prose ul li::before {
    content: "→";
    color: var(--color-primary);
    font-weight: bold;
  }
  .prose pre {
    background-color: #1e1e1e !important;
    padding: var(--spacing-stack-md);
    margin: var(--spacing-stack-md) 0;
    overflow-x: auto;
    border-radius: var(--radius-DEFAULT);
  }
</style>
